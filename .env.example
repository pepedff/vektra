# Copie para .env.local e preencha. Nunca coloque valores reais neste arquivo.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# PIX recebedor (usado para gerar o "copia e cola")
PIX_KEY=sua-chave-pix
PIX_MERCHANT_NAME=Nome do Recebedor
PIX_MERCHANT_CITY=Sua Cidade

# URL pública do site (usada em links de e-mail de confirmação/recuperação)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
